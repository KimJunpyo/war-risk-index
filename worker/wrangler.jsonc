// 전쟁 가능성 지수 API Worker(#53). account_id 는 넣지 않는다: 배포 때 환경변수 CLOUDFLARE_ACCOUNT_ID 로 준다
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "war-risk-api",
  "main": "src/index.ts",
  // 테스트 런타임(@cloudflare/vitest-plugin 의 workerd 1.20261110)이 지원하는 가장 최근 날짜. 더 뒤로 잡으면 테스트만 이 날짜로 돈다
  "compatibility_date": "2026-11-10",
  "r2_buckets": [
    {
      "binding": "BUCKET",
      // 버킷 이름은 공개 저장소에 남기지 않는다. 배포 때 R2_BUCKET 값으로 바꾼다(batch.py 가 api/… 를 올리는 버킷).
      // CI 는 .github/workflows/worker.yml 의 sed, 로컬은 R2_BUCKET 환경변수를 두고 npm run deploy.
      // 자리 표시값도 R2 이름 규칙(영문 소문자·숫자·-)을 지켜야 wrangler·vitest 가 설정을 읽는다
      "bucket_name": "replace-with-r2-bucket"
    }
  ],
  "vars": {
    // 쉼표로 구분한 허용 출처(backend/app/main.py 의 CORS_ORIGINS 와 같은 뜻). Vercel 주소는 #55 에서 넣는다
    "CORS_ORIGINS": "http://localhost:3000"
  }
}
