# Python
.venv/
__pycache__/
*.pyc

# 수집 데이터·산출물 (수집 스크립트로 재생성)
data/
out/
# 테스트 픽스처는 예외 (tests/fixtures/m12/make_fixture.py 로 만든 작은 사본)
!tests/fixtures/**/data/
!tests/fixtures/**/out/

# 비밀값
.env
.env.*
!.env.example

# 로컬 도구 설정
.claude/settings.local.json
.pytest_cache/

# Worker: 의존성·wrangler 로컬 상태, wrangler types 생성물, npm run deploy 의 치환 설정(실제 버킷 이름이 들어감)
worker/node_modules/
worker/.wrangler/
worker/worker-configuration.d.ts
worker/wrangler.deploy.jsonc
